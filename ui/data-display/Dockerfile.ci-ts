# typecheck + tests del paquete @devpablocristo/platform-ui-data-display.
# Build: context = padre que contiene `platform/`.
FROM node:20.19.0-bookworm-slim

WORKDIR /repo/platform
RUN corepack enable

COPY platform/ ./

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @devpablocristo/platform-ui-data-display run typecheck
RUN pnpm --filter @devpablocristo/platform-ui-data-display run test

CMD ["node", "-e", "console.log('platform-ui-data-display OK')"]

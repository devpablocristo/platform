# typecheck + tests del paquete @devpablocristo/platform-crud-ui.
# Build: context = padre que contiene `platform/`.
FROM node:20.19.0-bookworm-slim

WORKDIR /repo/platform
RUN corepack enable

COPY platform/ ./

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @devpablocristo/platform-crud-ui run typecheck
RUN pnpm --filter @devpablocristo/platform-crud-ui run test

CMD ["node", "-e", "console.log('platform-crud-ui OK')"]

# typecheck + tests del paquete @devpablocristo/platform-kanban-board.
# Build: context = padre que contiene `platform/`.
FROM node:20.19.0-bookworm-slim

WORKDIR /repo/platform
RUN corepack enable

COPY platform/ ./

RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter @devpablocristo/platform-kanban-board run typecheck
RUN pnpm --filter @devpablocristo/platform-kanban-board run test

CMD ["node", "-e", "console.log('platform-kanban-board OK')"]
